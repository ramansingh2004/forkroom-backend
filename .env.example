APP_NAME=ForkRoom API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://forkroom:forkroom@localhost:5434/forkroom
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://forkroom:forkroom@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REMINDER_WINDOW_MINUTES=60
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=3600

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=forkroom
MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret
MINIO_BUCKET=forkroom-attachments
MINIO_SECURE=false
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_URL_EXPIRE_MINUTES=15
ATTACHMENT_PROCESSING_MAX_ATTEMPTS=5
EXPORT_URL_EXPIRE_MINUTES=15
EXPORT_PROCESSING_MAX_ATTEMPTS=5

# Pydantic reads complex environment values as JSON.
CORS_ORIGINS=["http://localhost:3000"]

# Replace these before implementing authentication. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_COLLABORATION_SECRET=replace-with-a-third-long-random-collaboration-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COLLABORATION_TOKEN_EXPIRE_MINUTES=5
COLLABORATION_URL=ws://localhost:1234
MEETING_TOKEN_EXPIRE_MINUTES=5
MEETING_WEBSOCKET_URL=ws://localhost:8000/api/v1/ws/meetings
MEETING_ALLOWED_ORIGINS=["http://localhost:3000"]
MEETING_PRESENCE_TTL_SECONDS=60
MEETING_MAX_PARTICIPANTS=4
MEETING_MAX_TIMER_SECONDS=7200

# Browser-facing STUN/TURN addresses. Replace localhost with your public TURN host in production.
TURN_URLS=["stun:localhost:3478","turn:localhost:3478?transport=udp","turn:localhost:3478?transport=tcp"]
TURN_SHARED_SECRET=replace-with-a-long-random-turn-secret
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_REALM=forkroom.local
TURN_EXTERNAL_IP=127.0.0.1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-local-grafana-password

FRONTEND_URL=http://localhost:3000

# Slack integration. Create a Slack app with bot scopes:
# chat:write, channels:read, groups:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback
SLACK_BOT_SCOPES=chat:write,channels:read,groups:read

INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_OAUTH_STATE_TTL_SECONDS=600
INTEGRATION_HTTP_TIMEOUT_SECONDS=10
INTEGRATION_MAX_RETRIES=6

MAIL_FROM_ADDRESS=noreply@forkroom.local
MAIL_FROM_NAME=ForkRoom
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15

AUTH_RATE_LIMIT_WINDOW_SECONDS=60

REGISTER_RATE_LIMIT_REQUESTS=3
LOGIN_RATE_LIMIT_REQUESTS=5
REFRESH_RATE_LIMIT_REQUESTS=10
LOGOUT_RATE_LIMIT_REQUESTS=10
VERIFICATION_RATE_LIMIT_REQUESTS=3
FORGOT_PASSWORD_RATE_LIMIT_REQUESTS=3
RESET_PASSWORD_RATE_LIMIT_REQUESTS=5
